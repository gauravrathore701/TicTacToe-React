/* Cursed Shrine paper design — mirrors cursedshrine.com and the blog
   (bloging-app/src/styles/global.css). Keep tokens in sync. */
:root {
  --color-bg: #e8dfc9;
  --color-bg-sec: #ddd2b7;
  --color-ink: #2b2723;
  --color-ink-dim: #3f3830;
  --color-accent: #6b4a2f;
  --color-accent-dim: #8a6a4b;
  --color-muted: #6f6555;
  --color-line: #cbbd9e;
  --font-sans: ui-sans-serif, system-ui, sans-serif;

  /* X and O inks */
  --color-x: #6b4a2f;
  --color-o: #2f6f8f;

  font-family: var(--font-sans);
  line-height: 1.5;
  font-weight: 400;

  color-scheme: light;
  color: var(--color-ink);
  background-color: var(--color-bg);

  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background-image:
    linear-gradient(90deg,
      transparent 0 22%, rgba(90, 70, 40, 0.035) 22.2%, transparent 22.5%,
      transparent 0 57%, rgba(90, 70, 40, 0.03) 57.2%, transparent 57.5%,
      transparent 0 81%, rgba(90, 70, 40, 0.035) 81.2%, transparent 81.5%),
    linear-gradient(0deg, transparent 0 63%, rgba(90, 70, 40, 0.025) 63.15%, transparent 63.4%),
    repeating-linear-gradient(103deg, rgba(120, 95, 60, 0.028) 0 1px, transparent 1px 7px),
    repeating-linear-gradient(11deg, rgba(120, 95, 60, 0.022) 0 1px, transparent 1px 11px),
    radial-gradient(120% 90% at 50% 40%, transparent 55%, rgba(80, 62, 35, 0.06) 100%);
  background-attachment: fixed;
}

a { color: inherit; text-decoration: none; }

*,
*::before,
*::after {
  box-sizing: border-box;
}
